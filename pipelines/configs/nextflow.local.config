// Local configuration with placeholder container images.
//
//   nextflow run vb_HAP.nf -c configs/nextflow.local.config -params-file examples/hap/params.yaml
//
// vb_HAP.nf only needs python3 (pysam, numpy, pandas, scipy) and samtools,
// so it runs with no container from the `gaia` conda env (environment.yml).
//
// vb_IMM.nf runs third-party genotypers that must come from containers; set
// the image for each process you enable and run with `-profile docker`.
// See "Containers" in the top-level README.md for what each image must provide.

params {
    outputBucket = "results"     // local output directory
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-ueo', 'pipefail']
    errorStrategy = { task.exitStatus > 0 && task.attempt < 3 ? 'retry' : 'terminate' }
    maxRetries = 2

    // hap-eval (vb_HAP.nf)
    withName: subsetBamFiles      { cpus = 1; memory = { 1.GB * task.attempt } }
    withName: compareCigarStrings { cpus = 1; memory = { 2.GB * task.attempt } }
    withName: findMatches         { cpus = 1; memory = { 2.GB * task.attempt } }
    withName: summarizeResults    { cpus = 1; memory = { 2.GB * task.attempt } }

    // genotyping (vb_IMM.nf) - replace the images with your own builds
    withName: hlaTypeT1K     { container = 'REPLACE_ME/t1k:latest';            cpus = 4; memory = 16.GB }
    withName: ighgTypeT1K    { container = 'REPLACE_ME/t1k:latest';            cpus = 4; memory = 16.GB }
    withName: hlaType        { container = 'REPLACE_ME/hla-la:latest';         cpus = 8; memory = 60.GB }
    withName: hlaTypeKourami { container = 'REPLACE_ME/kourami:latest';        cpus = 2; memory = 16.GB }
    withName: immunotyper2   { container = 'REPLACE_ME/immunotyper-sr:latest'; cpus = 6; memory = 48.GB }
    withName: locityperMain  { container = 'REPLACE_ME/locityper:latest';      cpus = 8; memory = 32.GB }
}

profiles {
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
}
